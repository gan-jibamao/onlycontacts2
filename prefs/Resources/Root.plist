<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  OnlyContacts 设置面板正文（PreferenceBundle 的 Root.plist）
  所有单元格都绑定 defaults 域 com.rna.onlycontacts，
  插件（callservicesd 里）每 2 秒回读一次，改完即生效。
-->
<plist version="1.0">
<dict>
	<key>title</key>
	<string>OnlyContacts</string>
	<key>items</key>
	<array>

		<!-- ============ 来电 ============ -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>来电</string>
			<key>footerText</key><string>只允许通讯录里的号码打进来，判定在 callservicesd 的来电过滤器里做，铃根本不响。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>只允许通讯录来电</string>
			<key>id</key><string>oc_enabled</string>
			<key>defaults</key><string>com.rna.onlycontacts</string>
			<key>key</key><string>enabled</string>
			<key>default</key><true/>
			<key>PostNotification</key><string>com.rna.onlycontacts/prefsChanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSLinkListCell</string>
			<key>label</key><string>拦截方式</string>
			<key>id</key><string>oc_mode</string>
			<key>defaults</key><string>com.rna.onlycontacts</string>
			<key>key</key><string>mode</string>
			<key>default</key><integer>0</integer>
			<key>validValues</key>
			<array><integer>0</integer><integer>1</integer></array>
			<key>validTitles</key>
			<array>
				<string>打不进（对方被拒接）</string>
				<string>只过滤不响铃</string>
			</array>
			<key>PostNotification</key><string>com.rna.onlycontacts/prefsChanged</string>
		</dict>

		<!-- ============ 例外的放行 ============ -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>例外的放行</string>
			<key>footerText</key><string>110 / 119 / 120 这类短号和急呼号码永远放行，不受这里的设置影响。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>连打两次放行</string>
			<key>id</key><string>oc_repeat</string>
			<key>defaults</key><string>com.rna.onlycontacts</string>
			<key>key</key><string>allow_repeat</string>
			<key>default</key><false/>
			<key>PostNotification</key><string>com.rna.onlycontacts/prefsChanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSEditTextCell</string>
			<key>label</key><string>放行窗口（秒）</string>
			<key>id</key><string>oc_window</string>
			<key>defaults</key><string>com.rna.onlycontacts</string>
			<key>key</key><string>repeat_window</string>
			<key>default</key><integer>180</integer>
			<key>placeholder</key><string>180</string>
			<key>keyboard</key><string>NumbersAndPunctuation</string>
			<key>PostNotification</key><string>com.rna.onlycontacts/prefsChanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSEditTextCell</string>
			<key>label</key><string>尾号匹配位数</string>
			<key>id</key><string>oc_minmatch</string>
			<key>defaults</key><string>com.rna.onlycontacts</string>
			<key>key</key><string>min_match</string>
			<key>default</key><integer>7</integer>
			<key>placeholder</key><string>7</string>
			<key>keyboard</key><string>NumbersAndPunctuation</string>
			<key>PostNotification</key><string>com.rna.onlycontacts/prefsChanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>隐号/无号码时放行</string>
			<key>id</key><string>oc_noid</string>
			<key>defaults</key><string>com.rna.onlycontacts</string>
			<key>key</key><string>allow_unknown_id</string>
			<key>default</key><true/>
			<key>PostNotification</key><string>com.rna.onlycontacts/prefsChanged</string>
		</dict>

		<!-- ============ 高级 ============ -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>高级</string>
			<key>footerText</key><string>“真的拒接”用的是 restrict 闸门，只有 10 秒内真的打进来过的号码才会被拒接——你回拨陌生号码不会被误伤。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>真的拒接（restrict 闸门）</string>
			<key>id</key><string>oc_restrict</string>
			<key>defaults</key><string>com.rna.onlycontacts</string>
			<key>key</key><string>restrict_gate</string>
			<key>default</key><true/>
			<key>PostNotification</key><string>com.rna.onlycontacts/prefsChanged</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>写决策日志</string>
			<key>id</key><string>oc_log</string>
			<key>defaults</key><string>com.rna.onlycontacts</string>
			<key>key</key><string>log</string>
			<key>default</key><true/>
			<key>PostNotification</key><string>com.rna.onlycontacts/prefsChanged</string>
		</dict>

		<!-- ============ 命令行 ============ -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>命令行（可选）</string>
			<key>footerText</key><string>上面改完 2 秒内生效，不用重启、不用注销。
日志位置用 onlycontacts path 看。
终端里还能用：onlycontacts status / test 号码 / contacts / refresh / log 50
存完新联系人后想让白名单立刻更新，敲一次 onlycontacts refresh。</string>
		</dict>

	</array>
</dict>
</plist>